# Claude Code
CLAUDE.md
.claude/

# Secrets — local only, never push
.env

# Antigravity
.antigravitycli/
.agents/

# Local skills repo clone — not part of the site
temp-md-skills/

# macOS
.DS_Store

# IDE
.vscode/

# Draft content — staged here until the user approves it.
# See CLAUDE.md "Approval gating" for the per-area promotion workflow.
presentations/Presentations/_not_approved/
articles/Articles/_not_approved/
apps/_not_approved/
workshops/_not_approved/
blooms/_not_approved/
memory/_not_approved/
prompts/_not_approved/
books/_not_approved/

# Visual-gate scratch: shots.py screenshots for overflow/overlap review.
**/.shots/

# idea-viz working output: timestamped SVG/PNG/meta triplets, one set per iteration.
# Local scratch, not site content — a figure that belongs on the site gets embedded
# into its article as inline SVG instead.
diagrams/

# Local-only publications working folder — never pushed.
publications/

# X posts workbench. The drafts, the markdown, the registry and the hub stay local.
# Only the landing pages and the rendered cards ship, because every post on x.com
# links to its landing page and that link has to resolve for everyone.
#
# A bare `posts/` cannot work here: git will not re-include a path whose parent
# directory is excluded, so the exclusion is a glob over the children instead.
posts/*
!posts/x-html/
!posts/x-images/
# The card sources stay private; only the rendered PNGs are public.
posts/x-images/*.card.html
posts/x-images/*.art.svg

# npx skills CLI lockfile. The skills it tracks install into .agents/ and
# .claude/, both gitignored, so the lockfile would reference files absent
# from the repo.
skills-lock.json
